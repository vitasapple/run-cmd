{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Run Cmd",
  "version": "0.1.0",
  "identifier": "com.local.run-cmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Run Cmd",
        "width": 1080,
        "height": 720,
        "minWidth": 920,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns"]
  }
}
